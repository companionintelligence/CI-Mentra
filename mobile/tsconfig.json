{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "types": ["jest"]
  },
  "include": ["index.ts", "app.config.ts", "app.config.spec.ts", "src/**/*.ts", "src/**/*.tsx", "plugins/**/*.ts"],
  "exclude": ["node_modules", "ios", "android", "dist"]
}
