# MentraOS App Config
MENTRA_PACKAGE_NAME=com.yourcompany.mentra-bridge
MENTRA_API_KEY=your_mentra_api_key
MENTRA_PORT=7010
MENTRA_CLOUD_API_URL=https://api.mentra.glass
# SDK-compatible aliases (optional):
# PACKAGE_NAME=com.yourcompany.mentra-bridge
# MENTRAOS_API_KEY=your_mentra_api_key
# PORT=7010
# For CI-Server/tailscale environments, set this to your cloud API origin.
# Example: https://your-ci-server.your-tailnet.ts.net

# OpenAI Façade Config
FACADE_PORT=8080
FACADE_API_KEY=your_facade_api_key

# Provider Configuration
DEFAULT_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# Example remote Ollama endpoint over tailscale:
# OLLAMA_BASE_URL=http://ollama.your-tailnet.ts.net:11434
VLLM_BASE_URL=http://localhost:8000
OPENAI_API_KEY=

# Postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mentra

# Redis
REDIS_URL=redis://localhost:6379

# Audio / TTS
AUDIO_BASE_URL=http://localhost:8080
TTS_PROVIDER=mentra
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=

# Rate Limiting
RATE_LIMIT_RPM=60
RATE_LIMIT_TPM=100000
