# MentraOS App Config
MENTRA_PACKAGE_NAME=com.yourcompany.mentra-bridge
MENTRA_API_KEY=your_mentra_api_key
MENTRA_PORT=7010
MENTRA_CLOUD_API_URL=https://api.mentra.glass
# SDK-compatible aliases (optional):
# PACKAGE_NAME=com.yourcompany.mentra-bridge
# MENTRAOS_API_KEY=your_mentra_api_key
# PORT=7010
# For ci-server/tailscale environments, set this to your cloud API origin.
# Example: https://your-ci-server.your-tailnet.ts.net
MENTRA_RUNTIME_MODE=cloud
MENTRA_BLUETOOTH_SDK_VERSION=0.1.6
# mentra-live | even-realities | g2 | vuzix-z100 | nimo
MENTRA_BLUETOOTH_TARGET=mentra-live
MENTRA_BLUETOOTH_SDK_PACKAGE_PATH=

# OpenAI Façade Config
FACADE_PORT=8080
# Static bearer key for the façade. Used as the auth method when Portal OIDC is
# disabled, and as a service-client fallback when it is enabled. Empty = allow all (dev only).
FACADE_API_KEY=your_facade_api_key

# --- Auth A: CI-Portal OIDC resource server (validate a presented token) ---
# When enabled, the façade validates CI-Portal-issued JWTs (better-auth, EdDSA)
# as a resource server (JWKS + iss/aud/exp), like CI-Server's PortalTokenService.
PORTAL_OIDC_ENABLED=false
# The expected `iss` claim. CI-Portal serves discovery under /api/auth but signs
# `iss` as the BARE ORIGIN — do NOT add /api/auth here.
PORTAL_OIDC_ISSUER=https://hub.companionintelligence.com
PORTAL_OIDC_JWKS_URI=https://hub.companionintelligence.com/api/auth/jwks
# Comma-separated allowlist of accepted `aud` values (each equals a Portal client_id).
PORTAL_OIDC_AUDIENCE=ci-mentra,ci-import-tools,ci-server,ci-hub

# --- Auth B: CI-Portal OIDC login (interactive Auth Code + PKCE, like CI-Import-Tools) ---
# Browser sign-in at /api/auth/login → CI-Portal → /api/auth/callback. Establishes
# a server-side session; the session cookie also authorizes the façade.
MENTRA_OIDC_ENABLED=false
# Discovery base URL (INCLUDES /api/auth); discovery appends /.well-known/openid-configuration.
MENTRA_OIDC_ISSUER=https://hub.companionintelligence.com/api/auth
# Registered public PKCE client. A dedicated `ci-mentra` client should be
# registered in CI-Portal; `ci-import-tools` (allows localhost redirects) works for testing.
MENTRA_OIDC_CLIENT_ID=ci-mentra
MENTRA_OIDC_CLIENT_SECRET=
MENTRA_OIDC_SCOPES=openid profile email offline_access
# Optional explicit redirect URI; else derived as ${proto}://${host}/api/auth/callback.
MENTRA_OIDC_REDIRECT_URI=
MENTRA_OIDC_PROVIDER_NAME=Companion Intelligence
MENTRA_OIDC_POST_LOGOUT_REDIRECT_URI=
# Signs the session + tx cookies. Set in production so sessions survive restarts.
MENTRA_SESSION_SECRET=
MENTRA_SESSION_TTL_MS=2592000000

# Provider Configuration
# ollama | vllm | openai | hermes (the Hub-backed hermes/openclaw agent)
DEFAULT_PROVIDER=ollama

# --- Ollama (standardized on the CI-Hub instance) ---
# Resolution order: OLLAMA_BASE_URL > OLLAMA_HOST > LLM_API_BASE > default.
# In a Hub-managed container the canonical value is http://host.docker.internal:11434.
OLLAMA_BASE_URL=http://localhost:11434
# Hub/CI-Server convention aliases (either is accepted):
# OLLAMA_HOST=http://host.docker.internal:11434
# LLM_API_BASE=http://host.docker.internal:11434/v1
# Example remote Ollama endpoint over tailscale:
# OLLAMA_BASE_URL=http://ollama.your-tailnet.ts.net:11434
# Ollama ignores the key, but the Hub convention always sends a non-empty bearer.
OLLAMA_API_KEY=ollama
# Default chat model for the voice bridge (CI-Hub / CI-Server naming).
LLM_DEFAULT_CHAT_MODEL=llama3.2

VLLM_BASE_URL=http://localhost:8000
OPENAI_API_KEY=

# --- Backend: hermes / openclaw server on CI-Hub ---
# The Hub does not proxy inference; it hands each app an OpenAI-compatible
# endpoint. Point the `hermes` provider at the hermes/openclaw agent (or the
# Hub-provided Ollama /v1) directly, or discover it from the Hub at startup.
HERMES_OPENAI_BASE_URL=
HERMES_OPENAI_API_KEY=ollama
HERMES_DEFAULT_MODEL=
# Auto-discover inference credentials from the Hub (GET /api/inference/apps/<slug>/bootstrap.env).
# Fail-open: if the Hub is unreachable the app still starts on configured endpoints.
HUB_INFERENCE_BOOTSTRAP=false
CI_HUB_URL=http://ci-os-hub:3000
# Which Hub app slug's credentials to adopt: hermes-agent | openclaw
HUB_APP_SLUG=hermes-agent

# Postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mentra

# Redis
REDIS_URL=redis://localhost:6379

# Audio / TTS
AUDIO_BASE_URL=http://localhost:8080
TTS_PROVIDER=mentra
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=

# Rate Limiting
RATE_LIMIT_RPM=60
RATE_LIMIT_TPM=100000
